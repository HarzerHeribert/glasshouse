#!/usr/bin/env bash
# agy-gh — Antigravity as an unattended leaf worker, for building Glasshouse.
#
# `agy` declares exactly one unattended mode and no classifier-style automatic
# review, so a leaf worker either runs with a blanket approval bypass or it
# needs a human at the keyboard for every tool call. The flag below is quoted
# from `agy --help` and recorded, with that evidence, in
# crates/glasshouse/src/harness/antigravity.rs — this shim does not discover
# it, invent it, or hide it.
#
#   agy-gh [agy args...]        one Antigravity session, tools auto-approved
#   AGY_GH_ANYWHERE=1 agy-gh …  allow it outside a git work tree
#
# **Three things this is not.**
#
#  1. It is not the product. `glasshouse shim` (Phase 9B) generates shims for
#     users; it writes a different file, for a different purpose.
#  2. It does not pre-authorize anything. Glasshouse still refuses a profile
#     that asks for an unacknowledged bypass, and `bypass_acknowledged` is
#     still a statement a person makes on their own machine. Nothing here
#     writes it — this shim runs `agy` directly and never goes through
#     Glasshouse at all.
#  3. It is not a default. Nothing invokes it implicitly; a worker gets it
#     because a task packet named it.
#
# Authorized for development on this machine by the repository owner,
# 2026-08-26. Deleting this file is all it takes to remove it.
set -euo pipefail

if [ "${AGY_GH_ANYWHERE:-0}" != "1" ] && ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "agy-gh: refusing to auto-approve tools outside a git work tree." >&2
  echo "  cwd: $PWD" >&2
  echo "  leaf workers run in an isolated worktree; cd there first," >&2
  echo "  or set AGY_GH_ANYWHERE=1 if you meant this directory." >&2
  exit 2
fi

echo "agy-gh: tools auto-approved, in $PWD" >&2
exec agy --dangerously-skip-permissions "$@"
