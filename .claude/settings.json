{
  "permissions": {
    "allow": [
      "Read(/Users/eneas/projects/glasshouse/.agent-runtime/packet-*.md)",
      "Read(/Users/eneas/projects/glasshouse/.agent-runtime/report-*.md)",
      "Read(/Users/eneas/projects/glasshouse/.agent-runtime/subpacket-*.md)",
      "Write(/Users/eneas/projects/glasshouse/.agent-runtime/report-*.md)",
      "Edit(/Users/eneas/projects/glasshouse/.agent-runtime/report-*.md)",
      "Write(/Users/eneas/projects/glasshouse/.agent-runtime/subpacket-*.md)",
      "Edit(/Users/eneas/projects/glasshouse/.agent-runtime/subpacket-*.md)"
    ],
    "deny": [
      "Read(/Users/eneas/projects/glasshouse/.agent-runtime/provider-keys.env)",
      "Read(/Users/eneas/projects/glasshouse/.agent-runtime/*.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/guard-destructive-git.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/guard-worktree-boundary.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/coedit-peer-notice.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/coedit-claim-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/worker-turn-ended.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/coedit-unreleased-guard.sh"
          }
        ]
      }
    ]
  }
}
